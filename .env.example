# ---- Spotify credentials (REQUIRED, single-tenant) ----
# Create an app at https://developer.spotify.com/dashboard
# Env vars take priority over any stored config.json.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ---- Admin access for /settings and /api/config ----
# Change this before exposing the app publicly. If unset, local fallback is "admin".
ADMIN_PASSWORD=change_me

# Optional signing secret for the admin session cookie. If unset, ADMIN_PASSWORD is used.
ADMIN_SESSION_SECRET=change_me_too

# ---- Optional tuning ----
# Where downloaded audio + ZIPs are written (mounted as a volume in Docker).
DOWNLOAD_DIR=/app/downloads

# Queue state file (mounted volume).
SPOTIFY_QUEUE_FILE=/app/data/queue.json

# Max tracks returned per resolve request (clamp).
MAX_TRACKS_PER_REQUEST=50

# Simultaneous YouTube downloads (raise carefully — saturates network/CPU).
SPOTIFY_MAX_CONCURRENT_DOWNLOADS=3
