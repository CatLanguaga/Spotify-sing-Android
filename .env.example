# ============================================================================
# Spotify Sync — environment configuration
# ============================================================================
# Variables marked "# REQUIRED in production" must be set before exposing the
# app publicly. Run `python tools/check-admin-hardening.py` to verify.

# ---- Spotify credentials (optional) ----------------------------------------
# Create an app at https://developer.spotify.com/dashboard. If unset, the
# admin sets them once via /settings and they persist (encrypted at rest) in
# /app/data/config.json across redeploys. Env vars take priority if present.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Admin auth (round 1) --------------------------------------------------
# REQUIRED on first boot only. Seeds the admin user in the DB; subsequent
# boots ignore this env. Rotate via `python -m gui.backend.admin_cli reset-password admin`.
ADMIN_PASSWORD=change_me_strong_12_chars_min!

# REQUIRED in production. Signs admin session cookies. >= 32 bytes random.
# If unset, an auto-generated key is written to /app/data/.session_secret.
ADMIN_SESSION_SECRET=

# Set to 1 in production (forces Secure cookie + __Host- prefix).
ADMIN_COOKIE_SECURE=1

# Session lifetime (default 2h sliding) + idle timeout (default 30m).
ADMIN_SESSION_TTL_SECONDS=7200
ADMIN_IDLE_TIMEOUT_SECONDS=1800

# Per-install pepper for hashing IPs / UAs in the audit log. Rotating it
# breaks correlation of historical events.
ADMIN_META_PEPPER=

# ---- Transport hardening (round 2) -----------------------------------------
# Adds HSTS + CSP. Leave off in dev (Vite hot-reload uses ws:// + inline scripts).
SECURITY_HEADERS_STRICT=1

# Redirect plain-HTTP to HTTPS. Honors X-Forwarded-Proto for Coolify/Traefik.
FORCE_HTTPS=1

# Override the leaked "Server: uvicorn …" header.
SECURITY_SERVER_HEADER=nginx

# ---- At-rest encryption + stealth (round 3) --------------------------------
# REQUIRED in production. Fernet key (32 bytes url-safe base64).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, an auto-generated key is written to /app/data/.data_key.
ADMIN_DATA_KEY=

# 1 = admin surface returns 404 (not 401/403) when unauthenticated. Hides
# the existence of /api/admin/* and /api/config behind a generic SPA 404.
ADMIN_STEALTH=

# false = hides the "Admin" link from the public footer. True by default
# for self-hosters who want easy access from /settings.
ADMIN_FOOTER_LINK=true

# ---- Edge guards (round 4) -------------------------------------------------
# Cap on admin/config request body size (default 8 KB).
ADMIN_BODY_MAX_BYTES=8192

# 1 = reject empty UA / curl / python-requests on /api/admin/*. Off by default
# (legitimate scripts can bypass by sending X-Admin-Client: <anything>).
ADMIN_BLOCK_GENERIC_UA=

# Path override for the common-password blocklist (point at SecLists for
# stronger coverage). Bundled file is gui/backend/admin/data/common_passwords.txt.
ADMIN_PWNED_LIST=

# ---- Storage paths (Docker volume layout) ----------------------------------
DOWNLOAD_DIR=/app/downloads
SPOTIFY_QUEUE_FILE=/app/data/queue.json
SPOTIFY_CONFIG_DIR=/app/data
ADMIN_DB_PATH=/app/data/admin.sqlite3

# ---- Misc tuning -----------------------------------------------------------
MAX_TRACKS_PER_REQUEST=50
SPOTIFY_MAX_CONCURRENT_DOWNLOADS=3
